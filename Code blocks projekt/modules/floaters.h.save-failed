#include "global.h"


#ifndef FLOATERS_H_INCLUDED
#define FLOATERS_H_INCLUDED


typedef enum floaterType {
    enemy, projectile
} floaterType;

typedef struct floater {
    floaterType type;
    vector2D position;
    vector2D velocity;
    float slownessDebuffLeft;
    float size;
    struct floater* next;
} floater;


void createEnemy();
void createProjectile(vector3D playerPosition, vector3D playerSize, vector2D* playerVelocity, intVector2D mouse);

void moveFloaters(int deltaTime);

void getFloatersRenderObject(int x, int y, renderObject* renderMap, int renderObjectsPerCube);

void freeFloaterList();

#endif // FLOATERS_H_INCLUDED
